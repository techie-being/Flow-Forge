# Default (recommended for dev): leave unset. Requests go to /api/v1 and Vite proxies them to the backend.
# VITE_API_BASE=/api/v1

# Where the dev proxy forwards to
# VITE_BACKEND_URL=http://localhost:5000

# Or call the backend directly (then the backend CORS config must allow this exact
# frontend origin, e.g. http://localhost:5173, with credentials enabled):
# VITE_API_BASE=http://localhost:5000/api/v1
